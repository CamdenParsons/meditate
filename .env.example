# Copy to ~/.meditate/.env (or to .env beside this file) and fill in what
# you use. Everything here is optional: a provider that cannot answer is
# skipped, and the session is still recorded.

# Linear issues you updated during a session, with title and status.
# Create a personal API key: Linear > Settings > Security & access.
# LINEAR_API_KEY=lin_api_xxxxxxxx

# Only run some providers. Default is all of them.
# MEDITATE_ACTIVITY=claude,github,commits,linear,tickets

# Extra repositories to search for commits, beyond the ones your Claude
# sessions were in and the directory you ran from.
# MEDITATE_REPOS=/Users/you/src/api,/Users/you/src/www

# Print provider failures instead of swallowing them.
# MEDITATE_DEBUG=1

# Use your own ascii art above the clock.
# MEDITATE_ART=art/figure.txt
